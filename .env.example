# Скопируйте в .env и заполните значениями из Yandex Cloud
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite

# Токен от @BotFather. На Render webhook ставится сам, локально: python bot.py
TELEGRAM_BOT_TOKEN=

# Локальный запуск ходит в каталог артикулов на сайте, свою копию не ведёт.
# На Render эту переменную не задавать.
ARTICLES_SYNC_URL=https://tamozhenformat.onrender.com

# Только на Render. Ключи Object Storage Cloud.ru и имя бакета.
# Пока они пустые, сайт работает как раньше, без копии в S3.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_BUCKET=
