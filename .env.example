# Скопируйте в .env и заполните значениями из Yandex Cloud
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite

# Токен от @BotFather. На Render webhook ставится сам, локально: python bot.py
TELEGRAM_BOT_TOKEN=

# Откуда локальный запуск забирает правки артикулов. На Render не задавать.
ARTICLES_SYNC_URL=https://tamozhenformat.onrender.com
